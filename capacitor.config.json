{
  "appId": "com.fightwise.app",
  "appName": "FightWise",
  "webDir": "www",
  "bundledWebRuntime": false,
  "backgroundColor": "#0a0a0a",
  "plugins": {
    "SystemBars": {
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    }
